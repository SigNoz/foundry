# AWS EKS Outputs for {{ .Metadata.Name }}
# Generated by foundry - do not edit manually

# =============================================================================
# Cluster Outputs
# =============================================================================

output "cluster_name" {
  description = "Name of the EKS cluster"
  value       = aws_eks_cluster.main.name
}

output "cluster_endpoint" {
  description = "Endpoint for the EKS cluster API server"
  value       = aws_eks_cluster.main.endpoint
}

output "cluster_ca_certificate" {
  description = "Base64-encoded certificate authority data for the EKS cluster"
  value       = aws_eks_cluster.main.certificate_authority[0].data
  sensitive   = true
}

output "cluster_version" {
  description = "Kubernetes version of the EKS cluster"
  value       = aws_eks_cluster.main.version
}

# =============================================================================
# VPC Outputs
# =============================================================================

output "vpc_id" {
  description = "ID of the VPC"
  value       = aws_vpc.main.id
}

output "private_subnet_ids" {
  description = "IDs of the private subnets"
  value       = aws_subnet.private[*].id
}

output "public_subnet_ids" {
  description = "IDs of the public subnets"
  value       = aws_subnet.public[*].id
}

# =============================================================================
# Node Group Outputs
# =============================================================================
{{- if .Spec.TelemetryKeeper.Spec.Enabled }}

output "telemetrykeeper_node_group_arn" {
  description = "ARN of the TelemetryKeeper node group"
  value       = aws_eks_node_group.telemetrykeeper.arn
}

output "telemetrykeeper_node_group_status" {
  description = "Status of the TelemetryKeeper node group"
  value       = aws_eks_node_group.telemetrykeeper.status
}
{{- end }}

{{- if .Spec.TelemetryStore.Spec.Enabled }}

output "telemetrystore_node_group_arn" {
  description = "ARN of the TelemetryStore node group"
  value       = aws_eks_node_group.telemetrystore.arn
}

output "telemetrystore_node_group_status" {
  description = "Status of the TelemetryStore node group"
  value       = aws_eks_node_group.telemetrystore.status
}
{{- end }}

{{- if .Spec.MetaStore.Spec.Enabled }}

output "metastore_node_group_arn" {
  description = "ARN of the MetaStore node group"
  value       = aws_eks_node_group.metastore.arn
}

output "metastore_node_group_status" {
  description = "Status of the MetaStore node group"
  value       = aws_eks_node_group.metastore.status
}
{{- end }}

{{- if .Spec.Ingester.Spec.Enabled }}

output "ingester_node_group_arn" {
  description = "ARN of the Ingester node group"
  value       = aws_eks_node_group.ingester.arn
}

output "ingester_node_group_status" {
  description = "Status of the Ingester node group"
  value       = aws_eks_node_group.ingester.status
}
{{- end }}

{{- if .Spec.Signoz.Spec.Enabled }}

output "signoz_node_group_arn" {
  description = "ARN of the SigNoz node group"
  value       = aws_eks_node_group.signoz.arn
}

output "signoz_node_group_status" {
  description = "Status of the SigNoz node group"
  value       = aws_eks_node_group.signoz.status
}
{{- end }}
