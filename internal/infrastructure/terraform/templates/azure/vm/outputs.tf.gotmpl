# Azure VM Outputs for {{ .Metadata.Name }}
# Generated by foundry - do not edit manually

# =============================================================================
# Network Outputs
# =============================================================================

output "resource_group_name" {
  description = "Name of the Azure resource group"
  value       = azurerm_resource_group.main.name
}

output "vnet_id" {
  description = "ID of the virtual network"
  value       = azurerm_virtual_network.main.id
}

output "private_subnet_id" {
  description = "ID of the private subnet"
  value       = azurerm_subnet.private.id
}

output "public_subnet_id" {
  description = "ID of the public subnet"
  value       = azurerm_subnet.public.id
}

# =============================================================================
# VM Outputs
# =============================================================================
{{- if .Spec.TelemetryKeeper.Spec.Enabled }}

output "telemetrykeeper_vm_ids" {
  description = "IDs of the TelemetryKeeper VMs"
  value       = azurerm_linux_virtual_machine.telemetrykeeper[*].id
}

output "telemetrykeeper_private_ips" {
  description = "Private IP addresses of the TelemetryKeeper VMs"
  value       = azurerm_network_interface.telemetrykeeper[*].private_ip_address
}
{{- end }}

{{- if .Spec.TelemetryStore.Spec.Enabled }}

output "telemetrystore_vm_ids" {
  description = "IDs of the TelemetryStore VMs"
  value       = azurerm_linux_virtual_machine.telemetrystore[*].id
}

output "telemetrystore_private_ips" {
  description = "Private IP addresses of the TelemetryStore VMs"
  value       = azurerm_network_interface.telemetrystore[*].private_ip_address
}
{{- end }}

{{- if .Spec.MetaStore.Spec.Enabled }}

output "metastore_vm_ids" {
  description = "IDs of the MetaStore VMs"
  value       = azurerm_linux_virtual_machine.metastore[*].id
}

output "metastore_private_ips" {
  description = "Private IP addresses of the MetaStore VMs"
  value       = azurerm_network_interface.metastore[*].private_ip_address
}
{{- end }}

{{- if .Spec.Ingester.Spec.Enabled }}

output "ingester_vm_ids" {
  description = "IDs of the Ingester VMs"
  value       = azurerm_linux_virtual_machine.ingester[*].id
}

output "ingester_public_ips" {
  description = "Public IP addresses of the Ingester VMs"
  value       = azurerm_public_ip.ingester[*].ip_address
}

output "ingester_private_ips" {
  description = "Private IP addresses of the Ingester VMs"
  value       = azurerm_network_interface.ingester[*].private_ip_address
}
{{- end }}

{{- if .Spec.Signoz.Spec.Enabled }}

output "signoz_vm_ids" {
  description = "IDs of the SigNoz VMs"
  value       = azurerm_linux_virtual_machine.signoz[*].id
}

output "signoz_public_ips" {
  description = "Public IP addresses of the SigNoz VMs"
  value       = azurerm_public_ip.signoz[*].ip_address
}

output "signoz_private_ips" {
  description = "Private IP addresses of the SigNoz VMs"
  value       = azurerm_network_interface.signoz[*].private_ip_address
}
{{- end }}
