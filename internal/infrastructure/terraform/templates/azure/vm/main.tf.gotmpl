{{- if .Spec.Ingester.Spec.Enabled }}

resource "azurerm_public_ip" "ingester" {
  count               = {{ derefInt .Spec.Ingester.Spec.Cluster.Replicas }}
  name                = "${local.name}-ingester-pip-${count.index}"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name
  allocation_method   = "Static"
  sku                 = "Standard"

  tags = local.common_tags
}

resource "azurerm_network_interface" "ingester" {
  count               = {{ derefInt .Spec.Ingester.Spec.Cluster.Replicas }}
  name                = "${local.name}-ingester-nic-${count.index}"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name

  ip_configuration {
