}
{{- end }}

{{- if .Spec.MetaStore.Spec.Enabled }}

resource "azurerm_network_interface" "metastore" {
  count               = {{ derefInt .Spec.MetaStore.Spec.Cluster.Replicas }}
  name                = "${local.name}-metastore-nic-${count.index}"
