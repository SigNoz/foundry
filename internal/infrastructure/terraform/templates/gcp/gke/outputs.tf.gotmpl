# GCP GKE Outputs for {{ .Metadata.Name }}
# Generated by foundry - do not edit manually

# =============================================================================
# Cluster Outputs
# =============================================================================

output "cluster_name" {
  description = "Name of the GKE cluster"
  value       = google_container_cluster.main.name
}

output "cluster_endpoint" {
  description = "Endpoint for the GKE cluster master"
  value       = google_container_cluster.main.endpoint
  sensitive   = true
}

output "cluster_ca_certificate" {
  description = "Base64-encoded public certificate of the cluster's certificate authority"
  value       = google_container_cluster.main.master_auth[0].cluster_ca_certificate
  sensitive   = true
}

# =============================================================================
# Network Outputs
# =============================================================================

output "network_id" {
  description = "ID of the VPC network"
  value       = google_compute_network.main.id
}

output "private_subnetwork_id" {
  description = "ID of the private subnetwork"
  value       = google_compute_subnetwork.private.id
}

# =============================================================================
# Node Pool Outputs
# =============================================================================
{{- if .Spec.TelemetryKeeper.Spec.Enabled }}

output "telemetrykeeper_node_pool_id" {
  description = "ID of the TelemetryKeeper node pool"
  value       = google_container_node_pool.telemetrykeeper.id
}
{{- end }}

{{- if .Spec.TelemetryStore.Spec.Enabled }}

output "telemetrystore_node_pool_id" {
  description = "ID of the TelemetryStore node pool"
  value       = google_container_node_pool.telemetrystore.id
}
{{- end }}

{{- if .Spec.MetaStore.Spec.Enabled }}

output "metastore_node_pool_id" {
  description = "ID of the MetaStore node pool"
  value       = google_container_node_pool.metastore.id
}
{{- end }}

{{- if .Spec.Ingester.Spec.Enabled }}

output "ingester_node_pool_id" {
  description = "ID of the Ingester node pool"
  value       = google_container_node_pool.ingester.id
}
{{- end }}

{{- if .Spec.Signoz.Spec.Enabled }}

output "signoz_node_pool_id" {
  description = "ID of the SigNoz node pool"
  value       = google_container_node_pool.signoz.id
}
{{- end }}
