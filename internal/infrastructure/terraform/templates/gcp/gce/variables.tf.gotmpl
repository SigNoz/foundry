# GCP GCE Variables for {{ .Metadata.Name }}
# Generated by foundry - do not edit manually

variable "project_id" {
  description = "GCP project ID"
  type        = string
}

variable "region" {
  description = "GCP region to deploy resources"
  type        = string
  default     = "us-central1"
}

variable "name" {
  description = "The name of the deployment"
  type        = string
  default     = "{{ .Metadata.Name }}"
}

variable "private_subnet_cidr" {
  description = "CIDR block for the private subnet"
  type        = string
  default     = "10.0.1.0/24"
}

variable "public_subnet_cidr" {
  description = "CIDR block for the public subnet"
  type        = string
  default     = "10.0.2.0/24"
}

# =============================================================================
# TelemetryKeeper Variables
# =============================================================================

variable "telemetrykeeper_machine_type" {
  description = "GCE machine type for TelemetryKeeper"
  type        = string
  default     = "n2-standard-2"
}

variable "telemetrykeeper_disk_size" {
  description = "Boot disk size (GB) for TelemetryKeeper instances"
  type        = number
  default     = 20
}

