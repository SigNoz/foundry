receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318

processors:
  memory_limiter:
    check_interval: 5s
    limit_mib: 4000
    spike_limit_mib: 800
  resourcedetection:
    detectors:
      - env
      - system
    timeout: 5s
  batch: {}

exporters:
  otlphttp:
    endpoint: ${env:SIGNOZ_INGESTION_ENDPOINT}
{{- if .IngestionKey }}
    headers:
      signoz-ingestion-key: ${env:SIGNOZ_INGESTION_KEY}
{{- end }}

service:
  pipelines:
    traces:
      receivers: [otlp]
      processors: [memory_limiter, resourcedetection, batch]
      exporters: [otlphttp]
    metrics:
      receivers: [otlp]
      processors: [memory_limiter, resourcedetection, batch]
      exporters: [otlphttp]
    logs:
      receivers: [otlp]
      processors: [memory_limiter, resourcedetection, batch]
      exporters: [otlphttp]
