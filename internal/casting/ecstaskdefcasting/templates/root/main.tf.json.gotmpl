{
  "terraform": {
    "required_version": ">= 1.0",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": ">= 5.0"
      }
    }
  },
  "provider": {
    "aws": {
      "region": "${var.region}"
    }
  },
  "module": {
    "signoz": {
      "source": "./module",
      "region": "${var.region}",
      "ecs_cluster_id": "${var.ecs_cluster_id}",
      "subnet_ids": "${var.subnet_ids}",
      "security_group_ids": "${var.security_group_ids}",
      "service_discovery_namespace_id": "${var.service_discovery_namespace_id}",
      "config_bucket": "${var.config_bucket}",
      "task_role_arn": "${var.task_role_arn}",
      "task_execution_role_arn": "${var.task_execution_role_arn}",
      "log_retention_days": "${var.log_retention_days}"
      {{- if $.Spec.TelemetryKeeper.Spec.Enabled }},
      "telemetrykeeper_cpu": "${var.telemetrykeeper_cpu}",
      "telemetrykeeper_memory": "${var.telemetrykeeper_memory}"
      {{- end }}
      {{- if $.Spec.TelemetryStore.Spec.Enabled }},
      "telemetrystore_cpu": "${var.telemetrystore_cpu}",
      "telemetrystore_memory": "${var.telemetrystore_memory}",
      "migrator_cpu": "${var.migrator_cpu}",
      "migrator_memory": "${var.migrator_memory}"
      {{- end }}
      {{- if $.Spec.MetaStore.Spec.Enabled }},
      "metastore_cpu": "${var.metastore_cpu}",
      "metastore_memory": "${var.metastore_memory}"
      {{- end }}
      {{- if $.Spec.Signoz.Spec.Enabled }},
      "signoz_cpu": "${var.signoz_cpu}",
      "signoz_memory": "${var.signoz_memory}"
      {{- end }}
      {{- if $.Spec.Ingester.Spec.Enabled }},
      "ingester_cpu": "${var.ingester_cpu}",
      "ingester_memory": "${var.ingester_memory}"
      {{- end }}
    }
  }
}
