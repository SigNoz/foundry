{{- $name := $.Metadata.Name -}}
{{- $region := index $.Metadata.Annotations "foundry.signoz.io/ecs/region" -}}
{{- $configBucket := index $.Metadata.Annotations "foundry.signoz.io/ecs/config-bucket" -}}
{
  "locals": {
    "telemetrykeeper_container_definitions": [
      {
        "name": "config-fetcher",
        "image": "amazon/aws-cli:2.27.32",
        "essential": false,
        "entryPoint": ["/bin/sh", "-c"],
        "command": ["aws s3 cp s3://{{ $configBucket }}/{{ $name }}/telemetrykeeper/{{ $.Spec.TelemetryKeeper.Kind }}/ /configs/telemetrykeeper/ --recursive"],
        "mountPoints": [
          {
            "sourceVolume": "keeper-config",
            "containerPath": "/configs/telemetrykeeper"
          }
        ],
        "cpu": 10,
        "memory": 102,
        "memoryReservation": 102,
        "logConfiguration": {
          "logDriver": "awslogs",
          "options": {
            "awslogs-group": "/ecs/{{ $name }}",
            "awslogs-region": "{{ $region }}",
            "awslogs-stream-prefix": "telemetrykeeper-config-fetcher",
            "awslogs-create-group": "true"
          }
        }
      },
      {
        "name": "telemetrykeeper-{{ $.Spec.TelemetryKeeper.Kind }}",
        "image": "{{ $.Spec.TelemetryKeeper.Spec.Image }}",
        "essential": true,
        "command": ["/usr/bin/clickhouse-keeper", "--config-file=/etc/clickhouse-keeper/keeper.yaml"],
        {{- if $.Spec.TelemetryKeeper.Spec.Env }}
        "environment": [
          {{- $first := true }}
          {{- range $key, $value := $.Spec.TelemetryKeeper.Spec.Env }}
          {{- if not $first }},{{ end }}
          {
            "name": {{ $key | toJson }},
            "value": {{ $value | toJson }}
          }
          {{- $first = false }}
          {{- end }}
        ],
        {{- end }}
        "portMappings": [
          {"name": "keeper-client", "containerPort": 9181, "protocol": "tcp"},
          {"name": "keeper-raft", "containerPort": 9234, "protocol": "tcp"}
        ],
        "mountPoints": [
          {
            "sourceVolume": "keeper-data",
            "containerPath": "/var/lib/clickhouse-keeper"
          },
          {
            "sourceVolume": "keeper-config",
            "containerPath": "/etc/clickhouse-keeper"
          }
        ],
        "dependsOn": [
          {"containerName": "config-fetcher", "condition": "SUCCESS"}
        ],
        "cpu": "${var.telemetrykeeper_cpu}",
        "memory": "${var.telemetrykeeper_memory}",
        "memoryReservation": "${var.telemetrykeeper_memory}",
        "healthCheck": {
          "command": ["CMD-SHELL", "echo ruok | nc localhost 9181 || exit 1"],
          "interval": 30,
          "timeout": 5,
          "retries": 3,
          "startPeriod": 30
        },
        "logConfiguration": {
          "logDriver": "awslogs",
          "options": {
            "awslogs-group": "/ecs/{{ $name }}",
            "awslogs-region": "{{ $region }}",
            "awslogs-stream-prefix": "clickhouse-keeper",
            "awslogs-create-group": "true"
          }
        }
      }
    ]
  },
  "resource": {
    "aws_s3_object": {
      "telemetrykeeper_configs": {
        "for_each": "${fileset(\"${path.module}/configs/telemetrykeeper/{{ $.Spec.TelemetryKeeper.Kind }}\", \"**\")}",
        "bucket": "${var.config_bucket}",
        "key": "{{ $name }}/telemetrykeeper/{{ $.Spec.TelemetryKeeper.Kind }}/${each.value}",
        "source": "${path.module}/configs/telemetrykeeper/{{ $.Spec.TelemetryKeeper.Kind }}/${each.value}",
        "etag": "${filemd5(\"${path.module}/configs/telemetrykeeper/{{ $.Spec.TelemetryKeeper.Kind }}/${each.value}\")}"
      }
    },
    "aws_ecs_task_definition": {
      "telemetrykeeper": {
        "family": "{{ $name }}-telemetrykeeper",
        "network_mode": "awsvpc",
        "requires_compatibilities": ["EC2"],
        "task_role_arn": "${var.task_role_arn}",
        "execution_role_arn": "${var.task_execution_role_arn}",
        "container_definitions": "${jsonencode(local.telemetrykeeper_container_definitions)}",
        "volume": [
          {
            "name": "keeper-config",
            "docker_volume_configuration": {
              "scope": "task",
              "driver": "local"
            }
          },
          {
            "name": "keeper-data",
            "docker_volume_configuration": {
              "scope": "task",
              "driver": "local"
            }
          }
        ],
        "depends_on": ["aws_s3_object.telemetrykeeper_configs"]
      }
    },
    "aws_service_discovery_service": {
      "telemetrykeeper": {
        "name": "telemetrykeeper-{{ $.Spec.TelemetryKeeper.Kind }}",
        "dns_config": {
          "namespace_id": "${var.service_discovery_namespace_id}",
          "routing_policy": "MULTIVALUE",
          "dns_records": [
            {
              "ttl": 10,
              "type": "A"
            }
          ]
        },
        "health_check_custom_config": {
          "failure_threshold": 1
        }
      }
    },
    "aws_ecs_service": {
      "telemetrykeeper": {
        "name": "{{ $name }}-telemetrykeeper",
        "cluster": "${var.ecs_cluster_id}",
        "task_definition": "${aws_ecs_task_definition.telemetrykeeper.arn}",
        "desired_count": 1,
        "launch_type": "EC2",
        "network_configuration": {
          "subnets": "${var.subnet_ids}",
          "security_groups": "${var.security_group_ids}"
        },
        "service_registries": {
          "registry_arn": "${aws_service_discovery_service.telemetrykeeper.arn}"
        },
        "depends_on": ["aws_cloudwatch_log_group.ecs"]
      }
    }
  }
}
