{{- $name := $.Metadata.Name -}}
{{- $region := index $.Metadata.Annotations "foundry.signoz.io/ecs-region" -}}
{{- $configBucket := index $.Metadata.Annotations "foundry.signoz.io/ecs-config-bucket" -}}
{{- $taskRoleArn := index $.Metadata.Annotations "foundry.signoz.io/ecs-task-role-arn" -}}
{{- $taskExecutionRoleArn := index $.Metadata.Annotations "foundry.signoz.io/ecs-task-execution-role-arn" -}}

{
  "family": "{{ $name }}-telemetrykeeper",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["EC2"],
  "taskRoleArn": "{{ $taskRoleArn }}",
  "executionRoleArn": "{{ $taskExecutionRoleArn }}",
  "containerDefinitions": [
    {
      "name": "config-fetcher",
      "image": "amazon/aws-cli:2.27.32",
      "essential": false,
      "entryPoint": ["/bin/sh", "-c"],
      "command": ["aws s3 cp s3://{{ $configBucket }}/{{ $name }}/telemetrykeeper/{{ $.Spec.TelemetryKeeper.Kind }}/ /configs/telemetrykeeper/ --recursive"],
      "mountPoints": [
        {
          "sourceVolume": "keeper-config",
          "containerPath": "/configs/telemetrykeeper"
        }
      ],
      "cpu": 10,
      "memory": 102,
      "memoryReservation": 102,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/{{ $name }}",
          "awslogs-region": "{{ $region }}",
          "awslogs-stream-prefix": "telemetrykeeper-config-fetcher",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "clickhouse-keeper",
      "image": "{{ $.Spec.TelemetryKeeper.Spec.Image }}",
      "essential": true,
      "command": ["/usr/bin/clickhouse-keeper", "--config-file=/etc/clickhouse-keeper/keeper.yaml"],
      {{- if $.Spec.TelemetryKeeper.Spec.Env }}
      "environment": [
        {{- $first := true }}
        {{- range $key, $value := $.Spec.TelemetryKeeper.Spec.Env }}
        {{- if not $first }},{{ end }}
        {
          "name": {{ $key | toJson }},
          "value": {{ $value | toJson }}
        }
        {{- $first = false }}
        {{- end }}
      ],
      {{- end }}
      "portMappings": [
        {"name": "keeper-client", "containerPort": 9181, "protocol": "tcp"},
        {"name": "keeper-raft", "containerPort": 9234, "protocol": "tcp"}
      ],
      "mountPoints": [
        {
          "sourceVolume": "keeper-data",
          "containerPath": "/var/lib/clickhouse-keeper"
        },
        {
          "sourceVolume": "keeper-config",
          "containerPath": "/etc/clickhouse-keeper"
        }
      ],
      "dependsOn": [
        {"containerName": "config-fetcher", "condition": "SUCCESS"}
      ],
      "cpu": 256,
      "memory": 512,
      "memoryReservation": 512,
      "healthCheck": {
        "command": ["CMD-SHELL", "echo ruok | nc localhost 9181 || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/{{ $name }}",
          "awslogs-region": "{{ $region }}",
          "awslogs-stream-prefix": "clickhouse-keeper",
          "awslogs-create-group": "true"
        }
      }
    }
  ],
  "volumes": [
    {"name": "keeper-config", "dockerVolumeConfiguration": {"scope": "task", "driver": "local"}},
    {"name": "keeper-data", "dockerVolumeConfiguration": {"scope": "task", "driver": "local"}}
  ]
}
