{{- $name := print $.Metadata.Name "-mcp-server" -}}
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ $name }}
  labels:
    app.kubernetes.io/name: signoz-mcp-server
    app.kubernetes.io/instance: {{ $name }}
    app.kubernetes.io/version: {{ regexReplaceAll "^[^A-Za-z0-9]+|[^A-Za-z0-9]+$" ((parseImage $.Spec.MCP.Spec.Image).Tag | trunc 63) "" | quote }}
    app.kubernetes.io/managed-by: kustomize
automountServiceAccountToken: false
