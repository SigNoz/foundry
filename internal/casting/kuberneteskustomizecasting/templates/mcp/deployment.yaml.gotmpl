{{- $name := print $.Metadata.Name "-mcp-server" -}}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ $name }}
  labels:
    app.kubernetes.io/name: signoz-mcp-server
    app.kubernetes.io/instance: {{ $name }}
    app.kubernetes.io/version: {{ regexReplaceAll "^[^A-Za-z0-9]+|[^A-Za-z0-9]+$" ((parseImage $.Spec.MCP.Spec.Image).Tag | trunc 63) "" | quote }}
    app.kubernetes.io/managed-by: kustomize
spec:
  replicas: {{ int $.Spec.MCP.Spec.Cluster.Replicas }}
  selector:
    matchLabels:
      app.kubernetes.io/name: signoz-mcp-server
      app.kubernetes.io/instance: {{ $name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: signoz-mcp-server
        app.kubernetes.io/instance: {{ $name }}
    spec:
      serviceAccountName: {{ $name }}
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: mcp
          image: {{ $.Spec.MCP.Spec.Image }}
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          {{- if $.Spec.MCP.Spec.Env }}
          env:
            {{- range $key, $val := $.Spec.MCP.Spec.Env }}
            - name: {{ $key }}
              value: {{ $val | quote }}
            {{- end }}
          {{- end }}
          ports:
            - name: http
              containerPort: 8000
              protocol: TCP
          livenessProbe:
            httpGet:
              port: http
              path: /livez
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 1
            failureThreshold: 5
          readinessProbe:
            httpGet:
              port: http
              path: /readyz
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 1
            failureThreshold: 3
          resources:
            requests:
              cpu: 500m
              memory: 1024Mi
