{{- $name := print $.Metadata.Name "-mcp-server" -}}
apiVersion: v1
kind: Service
metadata:
  name: {{ $name }}
  labels:
    app.kubernetes.io/name: signoz-mcp-server
    app.kubernetes.io/instance: {{ $name }}
    app.kubernetes.io/version: {{ (parseImage $.Spec.MCP.Spec.Image).Tag | trunc 63 | trimSuffix "-" | quote }}
    app.kubernetes.io/managed-by: kustomize
spec:
  type: ClusterIP
  ports:
    - name: http
      port: 8000
      protocol: TCP
      targetPort: http
  selector:
    app.kubernetes.io/name: signoz-mcp-server
    app.kubernetes.io/instance: {{ $name }}
