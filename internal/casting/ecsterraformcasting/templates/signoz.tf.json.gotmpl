{{- $name := $.Metadata.Name -}}
{{- $sqlite := eq $.Spec.MetaStore.Kind.String "sqlite" -}}
{{- $replicas := derefIntDefault $.Spec.Signoz.Spec.Cluster.Replicas 1 -}}
{{- if lt $replicas 1 }}{{- $replicas = 1 -}}{{- end -}}
{
  "locals": {
    {{- range $i := until $replicas }}{{ if $i }},{{ end }}
    {{- $label := printf "signoz_%d" $i }}
    {{- $family := printf "%s-signoz-%d" $name $i }}
    "containers_{{ $label }}": [
      {
        "name": "{{ $family }}",
        "image": "{{ $.Spec.Signoz.Spec.Image }}",
        "logConfiguration": {
          "logDriver": "json-file",
          "options": {
            "max-size": "10m",
            "max-file": "3",
            "labels": "com.amazonaws.ecs.task-definition-family,com.amazonaws.ecs.container-name,com.amazonaws.ecs.task-arn,com.amazonaws.ecs.cluster"
          }
        },
        "essential": true,
        {{- $env := list }}
        {{- range $key, $value := $.Spec.Signoz.Spec.Env }}
        {{- $env = append $env (dict "name" $key "value" $value) }}
        {{- end }}
        {{- if $env }}
        "environment": {{ toJson $env }},
        {{- end }}
        "portMappings": [
          {"name": "http", "containerPort": 8080, "protocol": "tcp", "appProtocol": "http"},
          {"name": "opamp", "containerPort": 4320, "protocol": "tcp"}
        ],
        {{- if $sqlite }}
        "mountPoints": [
          {
            "sourceVolume": "signoz-data",
            "containerPath": "/var/lib/signoz"
          }
        ],
        {{- end }}
        "cpu": 512,
        "memoryReservation": 512,
        "healthCheck": {
          "command": ["CMD-SHELL", "wget --spider -q http://localhost:8080/api/v1/health || exit 1"],
          "interval": 30,
          "timeout": 5,
          "retries": 3,
          "startPeriod": 300
        }
      }
    ]
    {{- end }}
  },
  "resource": {
    "aws_ecs_task_definition": {
      {{- range $i := until $replicas }}{{ if $i }},{{ end }}
      {{- $label := printf "signoz_%d" $i }}
      {{- $family := printf "%s-signoz-%d" $name $i }}
      "{{ $label }}": {
        "family": "{{ $family }}",
        "tags": {{ toJson $.Labels }},
        "network_mode": "awsvpc",
        "requires_compatibilities": ["EC2"],
        "task_role_arn": "${local.task_role_arn}",
        "execution_role_arn": "${local.execution_role_arn}",
        "container_definitions": "${jsonencode(local.containers_{{ $label }})}"
        {{- if $sqlite }},
        "volume": [
          {
            "name": "signoz-data",
            "host_path": "/var/lib/foundry/{{ $name }}/metastore/{{ $.Spec.MetaStore.Kind.String }}/{{ $i }}"
          }
        ]
        {{- end }}
      }
      {{- end }}
    },
    "aws_service_discovery_service": {
      {{- range $i := until $replicas }}{{ if $i }},{{ end }}
      {{- $label := printf "signoz_%d" $i }}
      "{{ $label }}": {
        "name": "signoz-{{ $i }}",
        "tags": {{ toJson $.Labels }},
        "dns_config": {
          "namespace_id": "${aws_service_discovery_private_dns_namespace.main.id}",
          "dns_records": [
            {
              "ttl": 10,
              "type": "A"
            }
          ],
          "routing_policy": "MULTIVALUE"
        }
      }
      {{- end }}
    },
    "aws_ecs_service": {
      {{- range $i := until $replicas }}{{ if $i }},{{ end }}
      {{- $label := printf "signoz_%d" $i }}
      {{- $family := printf "%s-signoz-%d" $name $i }}
      "{{ $label }}": {
        "name": "{{ $family }}",
        "cluster": "${local.cluster_arn}",
        "task_definition": "${aws_ecs_task_definition.{{ $label }}.arn}",
        "desired_count": 1,
        "deployment_minimum_healthy_percent": {{ if $sqlite }}0{{ else }}100{{ end }},
        "deployment_maximum_percent": {{ if $sqlite }}100{{ else }}200{{ end }},
        "launch_type": "EC2",
        "deployment_circuit_breaker": {
          "enable": true,
          "rollback": true
        },
        "tags": {{ toJson $.Labels }},
        "network_configuration": {
          "subnets": "${local.subnet_ids}",
          "security_groups": "${local.security_group_ids}"
        },
        "service_registries": {
          "registry_arn": "${aws_service_discovery_service.{{ $label }}.arn}"
        }
      }
      {{- end }}
    }
  }
}
