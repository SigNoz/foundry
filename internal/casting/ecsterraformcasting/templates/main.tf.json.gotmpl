{{- $name := $.Metadata.Name -}}
{
  {{- if $.Substrate }}
  "data": {
    "aws_ecs_cluster": {
      "substrate": {
        "cluster_name": "{{ $.Substrate.ClusterName }}"
      }
    },
    "aws_vpc": {
      "substrate": {
        "tags": {{ toJson $.Substrate.VPC }}
      }
    },
    "aws_subnets": {
      "substrate": {
        "filter": [
          {
            "name": "vpc-id",
            "values": ["${local.vpc_id}"]
          }
        ],
        "tags": {{ toJson $.Substrate.Subnets }},
        "lifecycle": {
          "postcondition": [
            {
              "condition": "${length(self.ids) > 0}",
              "error_message": "infrastructure {{ $.Spec.Infrastructure.Name }} has no private subnet in this VPC to place tasks in."
            }
          ]
        }
      }
    },
    {{- /* Every group of the substrate carries its tags, so the derived name
           is what singles out the one tasks join. */}}
    "aws_security_group": {
      "substrate": {
        "name": "{{ $.Substrate.SecurityGroupName }}",
        "vpc_id": "${local.vpc_id}",
        "tags": {{ toJson $.Substrate.SecurityGroup }}
      }
    },
    "aws_instances": {
      "persistent": {
        "instance_tags": {{ toJson $.Substrate.Persistent }},
        "instance_state_names": ["running", "pending"]
      }
    },
    "aws_instance": {
      "persistent": {
        "for_each": "${toset(data.aws_instances.persistent.ids)}",
        "instance_id": "${each.value}"
      }
    },
    "aws_ebs_volumes": {
      "persistent": {
        "tags": {{ toJson $.Substrate.Persistent }},
        "lifecycle": {
          "postcondition": [
            {
              "condition": "${length(self.ids) > 0}",
              "error_message": "infrastructure {{ $.Spec.Infrastructure.Name }} has no persistent volume to claim."
            }
          ]
        }
      }
    },
    "aws_ebs_volume": {
      "persistent": {
        "for_each": "${toset(data.aws_ebs_volumes.persistent.ids)}",
        "filter": [
          {
            "name": "volume-id",
            "values": ["${each.value}"]
          }
        ]
      }
    }
  },
  {{- else if $.Stated.SubnetIDs }}
  {{- /* An awsvpc task on the EC2 launch type takes no public IP, so a public
         subnet gives it a route it cannot use. */}}
  "data": {
    "aws_subnet": {
      {{- range $index, $id := $.Stated.SubnetIDs }}{{ if $index }},{{ end }}
      "tasks_{{ $index }}": {
        "id": "${var.subnet_ids[{{ $index }}]}"
      }
      {{- end }}
    }
  },
  {{- end }}
  {{- /* A component reads `local.cluster_arn`, never the variable. */}}
  "locals": {
    "cluster_arn": "{{ if $.Substrate }}${data.aws_ecs_cluster.substrate.arn}{{ else }}${var.cluster_arn}{{ end }}",
    "subnet_ids": "{{ if $.Substrate }}${data.aws_subnets.substrate.ids}{{ else }}${var.subnet_ids}{{ end }}",
    "security_group_ids": {{ if $.Substrate }}["${data.aws_security_group.substrate.id}"]{{ else }}"${var.security_group_ids}"{{ end }},
    "vpc_id": "{{ if $.Substrate }}${data.aws_vpc.substrate.id}{{ else }}${var.vpc_id}{{ end }}",
    "task_role_arn": "{{ if $.Stated.TaskRoleARN }}${var.task_role_arn}{{ else }}${aws_iam_role.task.arn}{{ end }}",
    "execution_role_arn": "{{ if $.Stated.ExecutionRoleARN }}${var.execution_role_arn}{{ else }}${aws_iam_role.exec.arn}{{ end }}"
    {{- if $.Substrate }},
    "identities": {{ toJson $.Substrate.Identities }},
    "volume_instance": "${ merge([ for id, instance in data.aws_instance.persistent : { for device in instance.ebs_block_device : device.volume_id => id } ]...) }",
    "claims": "${ merge([ for id, volume in data.aws_ebs_volume.persistent : { for identity in split(\",\", volume.tags[\"{{ $.Substrate.IdentitiesKey }}\"]) : identity => id } if contains(keys(volume.tags), \"{{ $.Substrate.IdentitiesKey }}\") ]...) }",
    "unclaimed_volume_ids": "${ sort([ for id, volume in data.aws_ebs_volume.persistent : id if !contains(values(local.claims), id) ]) }",
    "claimed_volume_ids": "${ sort([ for id, volume in data.aws_ebs_volume.persistent : id if contains(values(local.claims), id) ]) }",
    "assignment_pool": "${ concat(local.unclaimed_volume_ids, local.claimed_volume_ids) }",
    "new_identities": "${ [ for identity in local.identities : identity if !contains(keys(local.claims), identity) ] }",
    "volumes": "${ { for identity in local.identities : identity => contains(keys(local.claims), identity) ? local.claims[identity] : element(local.assignment_pool, index(local.new_identities, identity)) } }",
    "seats": "${ { for identity, volume in local.volumes : identity => lookup(local.volume_instance, volume, \"unattached\") } }"
    {{- end }}
  },
  "resource": {
    {{- if $.Substrate }}
    {{- /* A claim lives on the volume, which outlives any instance it is
           attached to and this stack too. The seat is whichever instance holds
           the claimed volume, derived again on every plan. */}}
    "aws_ec2_tag": {
      "claims": {
        "for_each": "${ toset(values(local.volumes)) }",
        "resource_id": "${each.value}",
        "key": "{{ $.Substrate.IdentitiesKey }}",
        "value": "${ join(\",\", sort(distinct(concat([ for identity, volume in local.claims : identity if volume == each.value ], [ for identity, volume in local.volumes : identity if volume == each.value ])))) }",
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    {{- end }}
    {{- /* A role holds no data and dies with this stack. */}}
    {{- if or (not $.Stated.TaskRoleARN) (not $.Stated.ExecutionRoleARN) }}
    "aws_iam_role": {
      {{- $first := true }}
      {{- if not $.Stated.TaskRoleARN }}{{ if not $first }},{{ end }}{{ $first = false }}
      "task": {
        "name": "${var.task_role_name}",
        "assume_role_policy": "${jsonencode({\"Version\" = \"2012-10-17\", \"Statement\" = [{\"Action\" = \"sts:AssumeRole\", \"Effect\" = \"Allow\", \"Principal\" = {\"Service\" = \"ecs-tasks.amazonaws.com\"}}]})}",
        "tags": {{ toJson $.Labels }}
      }
      {{- end }}
      {{- if not $.Stated.ExecutionRoleARN }}{{ if not $first }},{{ end }}{{ $first = false }}
      "exec": {
        "name": "${var.execution_role_name}",
        "assume_role_policy": "${jsonencode({\"Version\" = \"2012-10-17\", \"Statement\" = [{\"Action\" = \"sts:AssumeRole\", \"Effect\" = \"Allow\", \"Principal\" = {\"Service\" = \"ecs-tasks.amazonaws.com\"}}]})}",
        "tags": {{ toJson $.Labels }}
      }
      {{- end }}
    },
    {{- end }}
    {{- if not $.Stated.ExecutionRoleARN }}
    "aws_iam_role_policy_attachment": {
      "exec": {
        "policy_arn": "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy",
        "role": "${aws_iam_role.exec.name}"
      }
    },
    {{- end }}
    {{- if not $.Stated.TaskRoleARN }}
    {{- /* GetLatestConfiguration acts on a session token, so it is unscoped. */}}
    "aws_iam_role_policy": {
      "task_appconfig_read": {
        "name": "${var.task_role_name}-appconfig-read",
        "role": "${aws_iam_role.task.id}",
        "policy": "${jsonencode({\"Version\" = \"2012-10-17\", \"Statement\" = [{\"Effect\" = \"Allow\", \"Action\" = [\"appconfig:StartConfigurationSession\"], \"Resource\" = [format(\"%s/environment/*/configuration/*\", aws_appconfig_application.main.arn)]}, {\"Effect\" = \"Allow\", \"Action\" = [\"appconfig:GetLatestConfiguration\"], \"Resource\" = \"*\"}]})}"
      }
    },
    {{- end }}
    "aws_service_discovery_private_dns_namespace": {
      "main": {
        "name": "{{ $name }}-installation.local",
        "vpc": "${local.vpc_id}",
        "tags": {{ toJson $.Labels }}{{ if $.Stated.SubnetIDs }},
        "lifecycle": {
          "precondition": [
            {{- range $index, $id := $.Stated.SubnetIDs }}{{ if $index }},{{ end }}
            {
              "condition": "${!data.aws_subnet.tasks_{{ $index }}.map_public_ip_on_launch}",
              "error_message": "subnet {{ $id }} assigns public IPs on launch; tasks on the EC2 launch type take no public IP, so state private subnets with a NAT route or VPC endpoints."
            }
            {{- end }}
          ]
        }{{ end }}
      }
    },
    {{- /* The sidecar rewrites the config in place, so a component that
           reloads it does not need the task replaced. */}}
    "aws_appconfig_application": {
      "main": {
        "name": "{{ $name }}-installation-appconfig",
        "description": "SigNoz component configuration",
        "tags": {{ toJson $.Labels }}
      }
    },
    "aws_appconfig_environment": {
      "main": {
        "name": "default",
        "application_id": "${aws_appconfig_application.main.id}",
        "tags": {{ toJson $.Labels }}
      }
    },
    {{- /* AppConfig serializes deployments per environment, so bake time is
           paid once per component on every apply. */}}
    "aws_appconfig_deployment_strategy": {
      "main": {
        "name": "{{ $name }}-installation-appconfig-strategy",
        "deployment_duration_in_minutes": 0,
        "final_bake_time_in_minutes": 0,
        "growth_factor": 100,
        "replicate_to": "NONE",
        "tags": {{ toJson $.Labels }}
      }
    }
  }
}
