{{- $name := $.Metadata.Name -}}
{
  {{- if $.Subnets.StatedIDs }}
  {{- /* An awsvpc task on the EC2 launch type takes no public IP, so a public
         subnet gives it a route it cannot use. */}}
  "data": {
    "aws_subnet": {
      {{- range $index, $id := $.Subnets.StatedIDs }}{{ if $index }},{{ end }}
      "tasks_{{ $index }}": {
        "id": "${var.subnet_ids[{{ $index }}]}"
      }
      {{- end }}
    }
  },
  {{- end }}
  {{- /* A component reads `local.cluster_arn`, never the variable. */}}
  "locals": {
    "cluster_arn": "${var.cluster_arn}",
    "subnet_ids": "${var.subnet_ids}",
    "security_group_ids": "${var.security_group_ids}",
    "vpc_id": "${var.vpc_id}",
    "task_role_arn": "{{ if $.TaskRole.IsStated }}${var.task_role_arn}{{ else }}${aws_iam_role.task.arn}{{ end }}",
    "execution_role_arn": "{{ if $.ExecutionRole.IsStated }}${var.execution_role_arn}{{ else }}${aws_iam_role.exec.arn}{{ end }}"
  },
  "resource": {
    {{- /* A role holds no data and dies with this stack. */}}
    {{- if or (not $.TaskRole.IsStated) (not $.ExecutionRole.IsStated) }}
    "aws_iam_role": {
      {{- $first := true }}
      {{- if not $.TaskRole.IsStated }}{{ if not $first }},{{ end }}{{ $first = false }}
      "task": {
        "name": "${var.task_role_name}",
        "assume_role_policy": "${jsonencode({\"Version\" = \"2012-10-17\", \"Statement\" = [{\"Action\" = \"sts:AssumeRole\", \"Effect\" = \"Allow\", \"Principal\" = {\"Service\" = \"ecs-tasks.amazonaws.com\"}}]})}",
        "tags": {{ toJson $.Labels }}
      }
      {{- end }}
      {{- if not $.ExecutionRole.IsStated }}{{ if not $first }},{{ end }}{{ $first = false }}
      "exec": {
        "name": "${var.execution_role_name}",
        "assume_role_policy": "${jsonencode({\"Version\" = \"2012-10-17\", \"Statement\" = [{\"Action\" = \"sts:AssumeRole\", \"Effect\" = \"Allow\", \"Principal\" = {\"Service\" = \"ecs-tasks.amazonaws.com\"}}]})}",
        "tags": {{ toJson $.Labels }}
      }
      {{- end }}
    },
    {{- end }}
    {{- if not $.ExecutionRole.IsStated }}
    "aws_iam_role_policy_attachment": {
      "exec": {
        "policy_arn": "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy",
        "role": "${aws_iam_role.exec.name}"
      }
    },
    {{- end }}
    {{- if not $.TaskRole.IsStated }}
    {{- /* GetLatestConfiguration acts on a session token, so it is unscoped. */}}
    "aws_iam_role_policy": {
      "task_appconfig_read": {
        "name": "${var.task_role_name}-appconfig-read",
        "role": "${aws_iam_role.task.id}",
        "policy": "${jsonencode({\"Version\" = \"2012-10-17\", \"Statement\" = [{\"Effect\" = \"Allow\", \"Action\" = [\"appconfig:StartConfigurationSession\"], \"Resource\" = [format(\"%s/environment/*/configuration/*\", aws_appconfig_application.main.arn)]}, {\"Effect\" = \"Allow\", \"Action\" = [\"appconfig:GetLatestConfiguration\"], \"Resource\" = \"*\"}]})}"
      }
    },
    {{- end }}
    "aws_service_discovery_private_dns_namespace": {
      "main": {
        "name": "{{ $name }}-installation.local",
        "vpc": "${local.vpc_id}",
        "tags": {{ toJson $.Labels }}{{ if $.Subnets.StatedIDs }},
        "lifecycle": {
          "precondition": [
            {{- range $index, $id := $.Subnets.StatedIDs }}{{ if $index }},{{ end }}
            {
              "condition": "${!data.aws_subnet.tasks_{{ $index }}.map_public_ip_on_launch}",
              "error_message": "subnet {{ $id }} assigns public IPs on launch; tasks on the EC2 launch type take no public IP, so state private subnets with a NAT route or VPC endpoints."
            }
            {{- end }}
          ]
        }{{ end }}
      }
    },
    {{- /* The sidecar rewrites the config in place, so a component that
           reloads it does not need the task replaced. */}}
    "aws_appconfig_application": {
      "main": {
        "name": "{{ $name }}-installation-appconfig",
        "description": "SigNoz component configuration",
        "tags": {{ toJson $.Labels }}
      }
    },
    "aws_appconfig_environment": {
      "main": {
        "name": "default",
        "application_id": "${aws_appconfig_application.main.id}",
        "tags": {{ toJson $.Labels }}
      }
    },
    {{- /* AppConfig serializes deployments per environment, so bake time is
           paid once per component on every apply. */}}
    "aws_appconfig_deployment_strategy": {
      "main": {
        "name": "{{ $name }}-installation-appconfig-strategy",
        "deployment_duration_in_minutes": 0,
        "final_bake_time_in_minutes": 0,
        "growth_factor": 100,
        "replicate_to": "NONE",
        "tags": {{ toJson $.Labels }}
      }
    }
  }
}
