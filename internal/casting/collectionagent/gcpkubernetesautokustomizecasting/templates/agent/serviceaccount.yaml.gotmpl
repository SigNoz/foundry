{{- $name := print $.Metadata.Name "-collector-agent" -}}
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ $name }}
  labels:
    app.kubernetes.io/name: {{ $name }}
    app.kubernetes.io/instance: {{ $.Metadata.Name }}
    app.kubernetes.io/component: collector-agent
    app.kubernetes.io/managed-by: kustomize
