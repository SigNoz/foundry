{{- $name := print $.Metadata.Name "-collector-deployment" -}}
apiVersion: opentelemetry.io/v1beta1
kind: OpenTelemetryCollector
metadata:
  name: {{ $name }}
  labels:
    app.kubernetes.io/name: {{ $name }}
    app.kubernetes.io/instance: {{ $.Metadata.Name }}
    app.kubernetes.io/component: collector-deployment
    app.kubernetes.io/managed-by: kustomize
spec:
  mode: deployment
  replicas: {{ derefIntDefault $.Spec.Collector.Spec.Cluster.Replicas 1 }}
  image: {{ $.Spec.Collector.Spec.Image }}
  serviceAccount: {{ $name }}
  env:
    - name: K8S_NODE_NAME
      valueFrom:
        fieldRef:
          fieldPath: spec.nodeName
    - name: K8S_POD_IP
      valueFrom:
        fieldRef:
          fieldPath: status.podIP
    - name: K8S_HOST_IP
      valueFrom:
        fieldRef:
          fieldPath: status.hostIP
    - name: K8S_POD_NAME
      valueFrom:
        fieldRef:
          fieldPath: metadata.name
    - name: K8S_POD_UID
      valueFrom:
        fieldRef:
          fieldPath: metadata.uid
    - name: K8S_NAMESPACE
      valueFrom:
        fieldRef:
          fieldPath: metadata.namespace
    {{- range $key, $val := $.Spec.Collector.Spec.Env }}
    - name: {{ $key }}
      value: {{ $val | quote }}
    {{- end }}
  # Names match the operator's own (otlp-grpc, otlp-http), or its derived ports duplicate them.
  ports:
    - name: health-check
      port: 13133
      protocol: TCP
    - name: otlp-grpc
      port: 4317
      protocol: TCP
    - name: otlp-http
      port: 4318
      protocol: TCP
  resources:
    requests:
      cpu: 100m
      memory: 100Mi
  config:
    {{- index $.Spec.Collector.Spec.Config.Data $.Spec.Collector.Kind.ConfigKey | fromYaml | toYaml | nindent 4 }}
