{
  "locals": {
    "container_definition": {
      "name": "{{ $.Container }}",
      "image": "{{ $.Spec.Collector.Spec.Image }}",
      "essential": true,
      {{- /* The collector image carries no shell, so the config reaches it as a
             value and not as a file a second container writes. */}}
      "command": ["--config=env:SIGNOZ_CONFIG_CONTENT"],
      "secrets": [
        {"name": "SIGNOZ_CONFIG_CONTENT", "valueFrom": "${aws_ssm_parameter.main.arn}"}
      ],
      {{- $env := list (dict "name" "FOUNDRY_CONFIG_DIGEST" "value" $.Digest) }}
      {{- range $key, $value := $.Spec.Collector.Spec.Env }}
      {{- $env = append $env (dict "name" $key "value" $value) }}
      {{- end }}
      "environment": {{ toJson $env }},
      {{- /* The task shares one network namespace, so the ports are the
             application containers' own localhost and take no hostPort. */}}
      "portMappings": [
        {"containerPort": 4317, "protocol": "tcp"},
        {"containerPort": 4318, "protocol": "tcp"},
        {"containerPort": 8006, "protocol": "tcp"}
      ],
      "cpu": 256,
      "memoryReservation": 512
    },
    "log_configuration": {
      "logDriver": "awsfirelens",
      "options": {
        "Name": "forward",
        "Host": "127.0.0.1",
        "Port": "8006",
        "tls": "off"
      }
    }
  },
  "resource": {
    {{- /* Terraform reads the config off disk at plan time, so a changed pour
           is a changed parameter version. */}}
    "aws_ssm_parameter": {
      "main": {
        "name": "{{ $.Parameter }}",
        "description": "SigNoz collection agent sidecar collector configuration",
        "type": "String",
        "value": "${file(\"${path.module}/{{ $.Source }}\")}",
        "tags": {{ toJson $.Labels }}
      }
    },
    {{- /* The ECS agent, not the task, resolves a secret, so the read belongs
           to the execution role. */}}
    "aws_iam_role_policy": {
      "parameter_read": {
        "name": "{{ $.Policy }}",
        "role": "${var.execution_role_name}",
        "policy": "${jsonencode({\"Version\" = \"2012-10-17\", \"Statement\" = [{\"Effect\" = \"Allow\", \"Action\" = [\"ssm:GetParameter\", \"ssm:GetParameters\"], \"Resource\" = [aws_ssm_parameter.main.arn]}]})}"
      }
    }
  }
}
