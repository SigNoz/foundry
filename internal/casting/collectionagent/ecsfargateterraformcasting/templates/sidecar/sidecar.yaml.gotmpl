receivers:
  # ECS bind-mounts the FireLens socket into the container carrying the router
  # configuration, so the collector reads the task's stdout off it.
  fluentforward:
    endpoint: unix:///var/run/fluent.sock
  awsecscontainermetrics:
    collection_interval: 20s

processors:
  resourcedetection:
    detectors:
      - env
      - ecs
  # The receiver emits a metric per container too, so the task set is named here.
  filter/ecs:
    metrics:
      include:
        match_type: strict
        metric_names:
          - ecs.task.memory.reserved
          - ecs.task.memory.utilized
          - ecs.task.cpu.reserved
          - ecs.task.cpu.utilized
          - ecs.task.network.rate.rx
          - ecs.task.network.rate.tx
          - ecs.task.storage.read_bytes
          - ecs.task.storage.write_bytes

service:
  pipelines:
    logs:
      receivers: [fluentforward]
    metrics:
      receivers: [awsecscontainermetrics]
      processors: [filter/ecs]
