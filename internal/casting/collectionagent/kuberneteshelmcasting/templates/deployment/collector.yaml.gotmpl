# The deployment's once-per-cluster additions mirror the k8s-infra chart
# 0.17.1 (app 0.139.0). Bodies replace the molding base; pipeline lists merge.
receivers:
  k8s_cluster:
    collection_interval: 30s
    allocatable_types_to_report:
      - cpu
      - memory
    node_conditions_to_report:
      - Ready
      - MemoryPressure
      - DiskPressure
      - PIDPressure
      - NetworkUnavailable
    metrics:
      k8s.container.status.reason:
        enabled: true
      k8s.container.status.state:
        enabled: true
      k8s.node.condition:
        enabled: true
      k8s.pod.status_reason:
        enabled: true
    resource_attributes:
      container.runtime:
        enabled: true
      container.runtime.version:
        enabled: true
      k8s.container.status.last_terminated_reason:
        enabled: true
      k8s.kubelet.version:
        enabled: true
      k8s.pod.qos_class:
        enabled: true
  k8s_events:
    auth_type: serviceAccount

processors:
  k8sattributes:
    passthrough: false
    extract:
      metadata:
        - k8s.namespace.name
        - k8s.deployment.name
        - k8s.statefulset.name
        - k8s.daemonset.name
        - k8s.cronjob.name
        - k8s.job.name
        - k8s.node.name
        - k8s.node.uid
        - k8s.pod.name
        - k8s.pod.uid
        - k8s.pod.start_time
    pod_association:
      - sources:
          - from: resource_attribute
            name: k8s.pod.ip
      - sources:
          - from: resource_attribute
            name: k8s.pod.uid
      - sources:
          - from: connection
  {{- if index $.Spec.Collector.Spec.Env "K8S_CLUSTER_NAME" }}
  resource/identity:
    # An unset env resolves to empty; insert lets a user-supplied value win.
    attributes:
      - key: k8s.cluster.name
        value: ${env:K8S_CLUSTER_NAME}
        action: insert
  {{- end }}
  resourcedetection:
    detectors:
      - env
    override: false
    timeout: 2s

service:
  pipelines:
    metrics:
      receivers:
        - k8s_cluster
      processors:
        {{- if index $.Spec.Collector.Spec.Env "K8S_CLUSTER_NAME" }}
        - resource/identity
        {{- end }}
        - k8sattributes
    logs:
      receivers:
        - k8s_events
      processors:
        {{- if index $.Spec.Collector.Spec.Env "K8S_CLUSTER_NAME" }}
        - resource/identity
        {{- end }}
        - k8sattributes
    traces:
      processors:
        {{- if index $.Spec.Collector.Spec.Env "K8S_CLUSTER_NAME" }}
        - resource/identity
        {{- end }}
        - k8sattributes
