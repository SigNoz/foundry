# The deployment's once-per-cluster additions mirror the k8s-infra chart
# 0.17.1 (app 0.139.0). Bodies replace the molding base; pipeline lists merge.
extensions:
  k8s_observer:
    auth_type: serviceAccount
    observe_nodes: true
    observe_pods: false

receivers:
  # Scrapes every node through the API-server proxy, since a Fargate pod cannot reach its kubelet.
  receiver_creator:
    watch_observers:
      - k8s_observer
    receivers:
      kubeletstats:
        rule: type == "k8s.node" && labels["eks.amazonaws.com/compute-type"] == "fargate"
        config:
          auth_type: kubeConfig
          collection_interval: 30s
          endpoint: '`name`'
          node: '`name`'
          k8s_api_config:
            auth_type: serviceAccount
          extra_metadata_labels:
            - container.id
            - k8s.volume.type
          metric_groups:
            - container
            - pod
            - node
            - volume
          metrics:
            container.cpu.usage:
              enabled: true
            container.uptime:
              enabled: true
            k8s.container.cpu.node.utilization:
              enabled: true
            k8s.container.memory.node.utilization:
              enabled: true
            k8s.container.cpu_limit_utilization:
              enabled: true
            k8s.container.cpu_request_utilization:
              enabled: true
            k8s.container.memory_limit_utilization:
              enabled: true
            k8s.container.memory_request_utilization:
              enabled: true
            k8s.node.cpu.usage:
              enabled: true
            k8s.node.uptime:
              enabled: true
            k8s.pod.cpu.usage:
              enabled: true
            k8s.pod.cpu_limit_utilization:
              enabled: true
            k8s.pod.cpu_request_utilization:
              enabled: true
            k8s.pod.memory_limit_utilization:
              enabled: true
            k8s.pod.memory_request_utilization:
              enabled: true
            k8s.pod.uptime:
              enabled: true
  k8s_cluster:
    collection_interval: 30s
    allocatable_types_to_report:
      - cpu
      - memory
    node_conditions_to_report:
      - Ready
      - MemoryPressure
      - DiskPressure
      - PIDPressure
      - NetworkUnavailable
    metrics:
      k8s.container.status.reason:
        enabled: true
      k8s.container.status.state:
        enabled: true
      k8s.node.condition:
        enabled: true
      k8s.pod.status_reason:
        enabled: true
    resource_attributes:
      container.runtime:
        enabled: true
      container.runtime.version:
        enabled: true
      k8s.container.status.last_terminated_reason:
        enabled: true
      k8s.kubelet.version:
        enabled: true
      k8s.pod.qos_class:
        enabled: true
  k8s_events:
    auth_type: serviceAccount

processors:
  k8sattributes:
    passthrough: false
    extract:
      metadata:
        - k8s.namespace.name
        - k8s.deployment.name
        - k8s.statefulset.name
        - k8s.daemonset.name
        - k8s.cronjob.name
        - k8s.job.name
        - k8s.node.name
        - k8s.node.uid
        - k8s.pod.name
        - k8s.pod.uid
        - k8s.pod.start_time
    pod_association:
      - sources:
          - from: resource_attribute
            name: k8s.pod.ip
      - sources:
          - from: resource_attribute
            name: k8s.pod.uid
      - sources:
          - from: connection
  resource/identity:
    # A Fargate pod cannot reach IMDS, so the platform is stated; insert lets a user value win.
    attributes:
      - key: cloud.provider
        value: aws
        action: insert
      - key: cloud.platform
        value: aws_eks
        action: insert
      {{- if index $.Spec.Collector.Spec.Env "K8S_CLUSTER_NAME" }}
      - key: k8s.cluster.name
        value: ${env:K8S_CLUSTER_NAME}
        action: insert
      {{- end }}
  resourcedetection:
    detectors:
      - env
    override: false
    timeout: 2s

service:
  extensions:
    - k8s_observer
  telemetry:
    logs:
      encoding: json
  pipelines:
    metrics:
      receivers:
        - k8s_cluster
        - receiver_creator
      processors:
        - resource/identity
        - k8sattributes
    logs:
      receivers:
        - k8s_events
      processors:
        - resource/identity
        - k8sattributes
    traces:
      processors:
        - resource/identity
        - k8sattributes
