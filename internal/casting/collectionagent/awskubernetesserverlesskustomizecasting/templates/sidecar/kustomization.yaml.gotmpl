apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
{{- with $.StatedNamespace }}

namespace: {{ . }}
{{- end }}

labels:
  - pairs:
      {{- range $key, $value := $.Labels }}
      {{ $key }}: {{ $value | quote }}
      {{- end }}
    includeSelectors: false
    includeTemplates: true

resources:
  - role.yaml
  - rolebinding.yaml
{{- if eq $.Controller "opentelemetry-operator" }}
  - opentelemetrycollector.yaml
{{- else }}

# The patch names the ConfigMap, so the generator adds no hash suffix.
generatorOptions:
  disableNameSuffixHash: true

configMapGenerator:
  - name: {{ $.Metadata.Name }}-collector-sidecar
    files:
      - sidecar.yaml
{{- end }}
