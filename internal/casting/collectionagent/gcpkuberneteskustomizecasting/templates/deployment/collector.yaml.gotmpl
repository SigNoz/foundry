processors:
  resourcedetection:
    # Cloud detectors follow env so a stated OTEL_RESOURCE_ATTRIBUTES wins; the
    # cluster-scoped collector takes no host or cluster identity from them.
    detectors:
      - env
      - gcp
    gcp:
      resource_attributes:
        gcp.gce.instance.hostname:
          enabled: false
        gcp.gce.instance.name:
          enabled: false
        host.id:
          enabled: false
        host.name:
          enabled: false
        host.type:
          enabled: false
        k8s.cluster.name:
          enabled: false
