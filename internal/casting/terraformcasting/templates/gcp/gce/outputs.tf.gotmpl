# GCP GCE Outputs for {{ .Metadata.Name }}
# Generated by foundry - do not edit manually

# =============================================================================
# Network Outputs
# =============================================================================

output "network_id" {
  description = "ID of the VPC network"
  value       = google_compute_network.main.id
}

output "private_subnetwork_id" {
  description = "ID of the private subnetwork"
  value       = google_compute_subnetwork.private.id
}

output "public_subnetwork_id" {
  description = "ID of the public subnetwork"
  value       = google_compute_subnetwork.public.id
}

# =============================================================================
# Compute Instance Outputs
# =============================================================================
{{- if .Spec.TelemetryKeeper.Spec.Enabled }}

output "telemetrykeeper_instance_ids" {
  description = "IDs of the TelemetryKeeper GCE instances"
  value       = google_compute_instance.telemetrykeeper[*].id
}

output "telemetrykeeper_private_ips" {
  description = "Private IP addresses of the TelemetryKeeper GCE instances"
  value       = [for i in google_compute_instance.telemetrykeeper : i.network_interface[0].network_ip]
}
{{- end }}

{{- if .Spec.TelemetryStore.Spec.Enabled }}

output "telemetrystore_instance_ids" {
  description = "IDs of the TelemetryStore GCE instances"
  value       = google_compute_instance.telemetrystore[*].id
}

output "telemetrystore_private_ips" {
  description = "Private IP addresses of the TelemetryStore GCE instances"
  value       = [for i in google_compute_instance.telemetrystore : i.network_interface[0].network_ip]
}
{{- end }}

{{- if .Spec.MetaStore.Spec.Enabled }}

output "metastore_instance_ids" {
  description = "IDs of the MetaStore GCE instances"
  value       = google_compute_instance.metastore[*].id
}

output "metastore_private_ips" {
  description = "Private IP addresses of the MetaStore GCE instances"
  value       = [for i in google_compute_instance.metastore : i.network_interface[0].network_ip]
}
{{- end }}

{{- if .Spec.Ingester.Spec.Enabled }}

output "ingester_instance_ids" {
  description = "IDs of the Ingester GCE instances"
  value       = google_compute_instance.ingester[*].id
}

output "ingester_public_ips" {
  description = "Public IP addresses of the Ingester GCE instances"
  value       = [for i in google_compute_instance.ingester : i.network_interface[0].access_config[0].nat_ip]
}

output "ingester_private_ips" {
  description = "Private IP addresses of the Ingester GCE instances"
  value       = [for i in google_compute_instance.ingester : i.network_interface[0].network_ip]
}
{{- end }}

{{- if .Spec.Signoz.Spec.Enabled }}

output "signoz_instance_ids" {
  description = "IDs of the SigNoz GCE instances"
  value       = google_compute_instance.signoz[*].id
}

output "signoz_public_ips" {
  description = "Public IP addresses of the SigNoz GCE instances"
  value       = [for i in google_compute_instance.signoz : i.network_interface[0].access_config[0].nat_ip]
}

output "signoz_private_ips" {
  description = "Private IP addresses of the SigNoz GCE instances"
  value       = [for i in google_compute_instance.signoz : i.network_interface[0].network_ip]
}
{{- end }}
