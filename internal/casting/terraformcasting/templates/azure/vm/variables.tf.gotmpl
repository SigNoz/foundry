# Azure VM Variables for {{ .Metadata.Name }}
# Generated by foundry - do not edit manually

variable "resource_group_name" {
  description = "Azure resource group name"
  type        = string
}

variable "location" {
  description = "Azure region to deploy resources"
  type        = string
  default     = "eastus"
}

variable "name" {
  description = "The name of the deployment"
  type        = string
  default     = "{{ .Metadata.Name }}"
}

variable "vnet_cidr" {
  description = "CIDR block for the virtual network"
  type        = string
  default     = "10.0.0.0/16"
}

variable "private_subnet_cidr" {
  description = "CIDR block for the private subnet"
  type        = string
  default     = "10.0.1.0/24"
}

variable "public_subnet_cidr" {
  description = "CIDR block for the public subnet"
  type        = string
  default     = "10.0.2.0/24"
}

variable "ssh_public_key" {
  description = "SSH public key for VM access"
  type        = string
}

# =============================================================================
# TelemetryKeeper Variables
# =============================================================================

variable "telemetrykeeper_vm_size" {
  description = "Azure VM size for TelemetryKeeper"
  type        = string
  default     = "Standard_B2s"
}

variable "telemetrykeeper_disk_size" {
  description = "OS disk size (GB) for TelemetryKeeper VMs"
  type        = number
  default     = 20
}

