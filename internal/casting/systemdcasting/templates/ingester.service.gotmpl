[Unit]
Description=SigNoz OTel Collector
Documentation=https://signoz.io/docs
After={{ $.Metadata.Name }}-telemetrystore-{{ $.Spec.TelemetryStore.Kind }}-0-0

[Service]
User=signoz
Group=signoz
Type=simple
KillMode=mixed
Restart=on-failure
WorkingDirectory=/opt/ingester
ExecStart=/opt/ingester/bin/ingester --config=/opt/ingester/{{ index $.Spec.Ingester.Status.Extras "cfgPath" }} --manager-config=/opt/ingester/{{ index $.Spec.Ingester.Status.Extras "cfgOpampPath" }}

[Install]
WantedBy=multi-user.target
