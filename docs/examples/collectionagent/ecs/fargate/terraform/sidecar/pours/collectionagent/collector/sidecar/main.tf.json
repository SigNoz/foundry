{
  "locals": {
    "execution_role_arn": "arn:aws:iam::123456789012:role/app-task-exec",
    "container_collector_sidecar": {
      "name": "signoz-collector-sidecar",
      "image": "otel/opentelemetry-collector-contrib:0.139.0",
      "essential": false,
      "restartPolicy": {"enabled": true},
      "firelensConfiguration": {"type": "fluentbit"},
      "command": ["--config=env:FOUNDRY_CONFIG"],
      "secrets": [
        {"name": "FOUNDRY_CONFIG", "valueFrom": "${aws_ssm_parameter.collector_sidecar.arn}:${aws_ssm_parameter.collector_sidecar.version}"}
      ],
      "environment": [{"name":"OTEL_COLLECTOR_ROLE","value":"sidecar"},{"name":"SIGNOZ_INGESTION_ENDPOINT","value":"https://ingest.us.signoz.cloud:443"}],
      "portMappings": [
        {"containerPort": 4317, "protocol": "tcp"},
        {"containerPort": 4318, "protocol": "tcp"}
      ],
      "cpu": 256,
      "memoryReservation": 256
    },
    "containers_collector_sidecar": ["${local.container_collector_sidecar}"],
    "log_configuration_collector_sidecar": {
      "logDriver": "awsfirelens",
      "options": {"Name": "signoz"}
    }
  },
  "resource": {
    "aws_ssm_parameter": {
      "collector_sidecar": {
        "name": "signoz-collectionagent-ssm-collector-sidecar",
        "description": "SigNoz collection agent sidecar collector configuration",
        "type": "String",
        "value": "${file(\"${path.module}/sidecar.yaml\")}",
        "tags": {"foundry.signoz.io/kind":"CollectionAgent","foundry.signoz.io/managed-by":"foundry","foundry.signoz.io/name":"signoz"}
      }
    },
    "aws_iam_role_policy": {
      "collector_sidecar": {
        "name": "signoz-collectionagent-iam-exec-ssm-read",
        "role": "${element(split(\"/\", local.execution_role_arn), length(split(\"/\", local.execution_role_arn)) - 1)}",
        "policy": "${jsonencode({\"Version\" = \"2012-10-17\", \"Statement\" = [{\"Effect\" = \"Allow\", \"Action\" = [\"ssm:GetParameter\", \"ssm:GetParameters\"], \"Resource\" = [aws_ssm_parameter.collector_sidecar.arn]}]})}"
      }
    }
  }
}
