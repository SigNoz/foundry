{
  "locals": {
    "container_definition": {
      "name": "signoz-collector-sidecar",
      "image": "otel/opentelemetry-collector-contrib:0.139.0",
      "essential": true,
      "command": ["--config=env:SIGNOZ_CONFIG_CONTENT"],
      "secrets": [
        {"name": "SIGNOZ_CONFIG_CONTENT", "valueFrom": "${aws_ssm_parameter.main.arn}"}
      ],
      "environment": [{"name":"FOUNDRY_CONFIG_DIGEST","value":"5a3cb28da47749d8d66fadc1dd9a6eacbdb664756b248a93d9c02f926ca3b9c9"},{"name":"OTEL_COLLECTOR_ROLE","value":"sidecar"},{"name":"SIGNOZ_INGESTION_ENDPOINT","value":"https://ingest.us.signoz.cloud:443"}],
      "portMappings": [
        {"containerPort": 4317, "protocol": "tcp"},
        {"containerPort": 4318, "protocol": "tcp"},
        {"containerPort": 8006, "protocol": "tcp"}
      ],
      "cpu": 256,
      "memoryReservation": 512
    },
    "log_configuration": {
      "logDriver": "awsfirelens",
      "options": {
        "Name": "forward",
        "Host": "127.0.0.1",
        "Port": "8006",
        "tls": "off"
      }
    }
  },
  "resource": {
    "aws_ssm_parameter": {
      "main": {
        "name": "/signoz-collectionagent/collector/sidecar",
        "description": "SigNoz collection agent sidecar collector configuration",
        "type": "String",
        "value": "${file(\"${path.module}/collector/sidecar/sidecar.yaml\")}",
        "tags": {"foundry.signoz.io/kind":"CollectionAgent","foundry.signoz.io/managed-by":"foundry","foundry.signoz.io/name":"signoz"}
      }
    },
    "aws_iam_role_policy": {
      "parameter_read": {
        "name": "signoz-collectionagent-parameter-read",
        "role": "${var.execution_role_name}",
        "policy": "${jsonencode({\"Version\" = \"2012-10-17\", \"Statement\" = [{\"Effect\" = \"Allow\", \"Action\" = [\"ssm:GetParameter\", \"ssm:GetParameters\"], \"Resource\" = [aws_ssm_parameter.main.arn]}]})}"
      }
    }
  }
}
