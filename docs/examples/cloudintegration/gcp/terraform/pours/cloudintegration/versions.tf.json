{
  "terraform": {
    "required_version": ">= 1.5.7, < 2.0.0",
    "required_providers": {
      "google": {
        "source": "hashicorp/google",
        "version": "7.27.0"
      },
      "google-beta": {
        "source": "hashicorp/google-beta",
        "version": "7.27.0"
      },
      "time": {
        "source": "hashicorp/time",
        "version": "0.13.1"
      }
    }
  },
  "provider": {
    "google": {
      "//": "Infrastructure Manager supplies credentials and manages the Terraform backend.",
      "project": "${var.project_id}",
      "region": "${var.deployment_region}"
    },
    "google-beta": {
      "//": "Generating the Pub/Sub service identity requires the beta provider.",
      "project": "${var.project_id}",
      "region": "${var.deployment_region}"
    }
  }
}
