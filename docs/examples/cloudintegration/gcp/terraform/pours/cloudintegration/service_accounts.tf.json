{
  "resource": {
    "google_service_account": {
      "agent": {
        "project": "${var.project_id}",
        "account_id": "${local.name_prefix}-agent",
        "display_name": "SigNoz integration agent",
        "depends_on": ["time_sleep.api_activation"]
      },
      "collector": {
        "project": "${var.project_id}",
        "account_id": "${local.name_prefix}-collector",
        "display_name": "SigNoz telemetry collector",
        "depends_on": ["time_sleep.api_activation"]
      },
      "pubsub_push": {
        "//": "Service account IDs allow only a-z, 0-9 and \"-\", 6-30 chars.",
        "project": "${var.project_id}",
        "account_id": "${local.name_prefix}-logs-push",
        "display_name": "SigNoz Pub/Sub push authentication",
        "depends_on": ["time_sleep.api_activation"]
      }
    },
    "google_project_service_identity": {
      "pubsub": {
        "provider": "google-beta",
        "project": "${var.project_id}",
        "service": "pubsub.googleapis.com",
        "depends_on": ["time_sleep.api_activation"]
      }
    },
    "google_service_account_iam_member": {
      "agent_uses_collector": {
        "//": "Updating a Collector revision requires actAs on its runtime identity. The Agent cannot act as the push account, itself, or the customer bootstrap executor.",
        "service_account_id": "${google_service_account.collector.name}",
        "role": "roles/iam.serviceAccountUser",
        "member": "serviceAccount:${google_service_account.agent.email}"
      },
      "pubsub_mints_push_tokens": {
        "//": "Pub/Sub, rather than the Agent, mints the OIDC token for authenticated push. This binding needs only identity-token minting, not OAuth access tokens or signing.",
        "service_account_id": "${google_service_account.pubsub_push.name}",
        "role": "roles/iam.serviceAccountOpenIdTokenCreator",
        "member": "${google_project_service_identity.pubsub.member}"
      }
    }
  }
}
