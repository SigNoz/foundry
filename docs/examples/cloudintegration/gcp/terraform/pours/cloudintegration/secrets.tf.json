{
  "data": {
    "google_secret_manager_secret": {
      "api_key": {
        "//": "The customer owns secret creation and version uploads. These lookups read metadata only, so credential payloads never enter Terraform inputs/state.",
        "project": "${var.project_id}",
        "secret_id": "${var.api_secret_id}",
        "lifecycle": {
          "precondition": [
            {
              "condition": "${var.api_secret_id != var.ingestion_secret_id}",
              "error_message": "Use different secrets for the API and ingestion keys so the Collector cannot read the API key."
            }
          ],
          "postcondition": [
            {
              "condition": "${try(self.labels[\"managed-by\"], \"\") == \"signoz\"}",
              "error_message": "The API-key secret must be labeled managed-by=signoz. Create the integration secret before deploying bootstrap."
            }
          ]
        },
        "depends_on": ["time_sleep.api_activation"]
      },
      "ingestion_key": {
        "project": "${var.project_id}",
        "secret_id": "${var.ingestion_secret_id}",
        "lifecycle": {
          "postcondition": [
            {
              "condition": "${try(self.labels[\"managed-by\"], \"\") == \"signoz\"}",
              "error_message": "The ingestion-key secret must be labeled managed-by=signoz. Create the integration secret before deploying bootstrap."
            }
          ]
        },
        "depends_on": ["time_sleep.api_activation"]
      }
    }
  },
  "resource": {
    "google_secret_manager_secret_iam_member": {
      "agent_api_key": {
        "project": "${var.project_id}",
        "secret_id": "${data.google_secret_manager_secret.api_key.secret_id}",
        "role": "roles/secretmanager.secretAccessor",
        "member": "serviceAccount:${google_service_account.agent.email}"
      },
      "agent_ingestion_key": {
        "project": "${var.project_id}",
        "secret_id": "${data.google_secret_manager_secret.ingestion_key.secret_id}",
        "role": "roles/secretmanager.secretAccessor",
        "member": "serviceAccount:${google_service_account.agent.email}"
      },
      "collector_ingestion_key": {
        "project": "${var.project_id}",
        "secret_id": "${data.google_secret_manager_secret.ingestion_key.secret_id}",
        "role": "roles/secretmanager.secretAccessor",
        "member": "serviceAccount:${google_service_account.collector.email}"
      }
    }
  }
}
