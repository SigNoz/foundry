{
  "family": "signoz-ingester",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["EC2"],
  "taskRoleArn": "",
  "executionRoleArn": "",
  "containerDefinitions": [
    {
      "name": "config-fetcher",
      "image": "amazon/aws-cli:2.27.32",
      "essential": false,
      "entryPoint": ["/bin/sh", "-c"],
      "command": ["aws s3 cp s3:///signoz/ingester/ /configs/ingester/ --recursive"],
      "mountPoints": [
        {
          "sourceVolume": "ingester-config",
          "containerPath": "/configs/ingester"
        }
      ],
      "cpu": 10,
      "memory": 102,
      "memoryReservation": 102,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/signoz",
          "awslogs-region": "",
          "awslogs-stream-prefix": "ingester-config-fetcher",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "otel-collector",
      "image": "signoz/signoz-otel-collector:latest",
      "essential": true,
      "entryPoint": ["/bin/sh", "-c"],
      "command": ["/signoz-otel-collector migrate sync check && /signoz-otel-collector --config=/conf/ingester.yaml --manager-config=/conf/opamp.yaml --copy-path=/var/tmp/collector-config.yaml"],
      "environment": [

        {"name": "SIGNOZ_OTEL_COLLECTOR_CLICKHOUSE_DSN", "value": "tcp://telemetrystore:9000"}

      ],
      "portMappings": [
        {"name": "otel-grpc", "containerPort": 4317, "protocol": "tcp"},
        {"name": "otel-http", "containerPort": 4318, "protocol": "tcp"}
      ],
      "mountPoints": [
        {
          "sourceVolume": "ingester-config",
          "containerPath": "/conf"
        }
      ],
      "dependsOn": [
        {"containerName": "config-fetcher", "condition": "SUCCESS"}
      ],
      "cpu": 512,
      "memory": 512,
      "memoryReservation": 256,
      "healthCheck": {
        "command": ["CMD-SHELL", "wget --spider -q localhost:13133 || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/signoz",
          "awslogs-region": "",
          "awslogs-stream-prefix": "otel-collector",
          "awslogs-create-group": "true"
        }
      }
    }
  ],
  "volumes": [
    {"name": "ingester-config", "dockerVolumeConfiguration": {"scope": "task", "driver": "local"}}
  ]
}
