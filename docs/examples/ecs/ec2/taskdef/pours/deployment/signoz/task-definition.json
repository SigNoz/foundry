{
  "family": "signoz-signoz",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["EC2"],
  "taskRoleArn": "",
  "executionRoleArn": "",
  "containerDefinitions": [
    {
      "name": "signoz",
      "image": "signoz/signoz:latest",
      "essential": true,
      "environment": [
        {
          "name": "SIGNOZ_SQLSTORE_POSTGRES_DSN",
          "value": "postgres://signoz:signoz@metastore:5432/signoz?sslmode=disable"
        },
        {
          "name": "SIGNOZ_SQLSTORE_PROVIDER",
          "value": "postgres"
        },
        {
          "name": "SIGNOZ_TELEMETRYSTORE_CLICKHOUSE_DSN",
          "value": "tcp://telemetrystore:9000"
        },
        {
          "name": "SIGNOZ_TELEMETRYSTORE_PROVIDER",
          "value": "clickhouse"
        }
      ],
      "portMappings": [
        {"name": "signoz-http", "containerPort": 8080, "protocol": "tcp"},
        {"name": "signoz-opamp", "containerPort": 4320, "protocol": "tcp"}
      ],
      "cpu": 512,
      "memory": 512,
      "memoryReservation": 256,
      "healthCheck": {
        "command": ["CMD-SHELL", "wget --spider -q localhost:8080/api/v1/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/signoz",
          "awslogs-region": "",
          "awslogs-stream-prefix": "signoz",
          "awslogs-create-group": "true"
        }
      }
    }
  ],
  "volumes": []
}
