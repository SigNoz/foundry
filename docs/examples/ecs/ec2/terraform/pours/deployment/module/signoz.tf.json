{
  "locals": {
    "signoz_container_definitions": [
      {
        "name": "signoz",
        "image": "signoz/signoz:latest",
        "essential": true,
        "environment": [
          {
            "name": "SIGNOZ_SQLSTORE_POSTGRES_DSN",
            "value": "postgres://signoz:signoz@metastore-postgres:5432/signoz?sslmode=disable"
          },
          {
            "name": "SIGNOZ_SQLSTORE_PROVIDER",
            "value": "postgres"
          },
          {
            "name": "SIGNOZ_TELEMETRYSTORE_CLICKHOUSE_DSN",
            "value": "tcp://telemetrystore-clickhouse:9000"
          },
          {
            "name": "SIGNOZ_TELEMETRYSTORE_PROVIDER",
            "value": "clickhouse"
          }
        ],
        "portMappings": [
          {"name": "signoz-http", "containerPort": 8080, "protocol": "tcp"},
          {"name": "signoz-opamp", "containerPort": 4320, "protocol": "tcp"}
        ],
        "cpu": "${var.signoz_cpu}",
        "memory": "${var.signoz_memory}",
        "memoryReservation": "${var.signoz_memory}",
        "healthCheck": {
          "command": ["CMD-SHELL", "wget --spider -q localhost:8080/api/v1/health || exit 1"],
          "interval": 30,
          "timeout": 5,
          "retries": 3,
          "startPeriod": 30
        },
        "logConfiguration": {
          "logDriver": "awslogs",
          "options": {
            "awslogs-group": "/ecs/signoz",
            "awslogs-region": "",
            "awslogs-stream-prefix": "signoz",
            "awslogs-create-group": "true"
          }
        }
      }
    ]
  },
  "resource": {
    "aws_ecs_task_definition": {
      "signoz": {
        "family": "signoz-signoz",
        "network_mode": "awsvpc",
        "requires_compatibilities": ["EC2"],
        "task_role_arn": "${var.task_role_arn}",
        "execution_role_arn": "${var.task_execution_role_arn}",
        "container_definitions": "${jsonencode(local.signoz_container_definitions)}"
      }
    },
    "aws_service_discovery_service": {
      "signoz": {
        "name": "signoz",
        "dns_config": {
          "namespace_id": "${var.service_discovery_namespace_id}",
          "routing_policy": "MULTIVALUE",
          "dns_records": [
            {
              "ttl": 10,
              "type": "A"
            }
          ]
        },
        "health_check_custom_config": {
          "failure_threshold": 1
        }
      }
    },
    "aws_ecs_service": {
      "signoz": {
        "name": "signoz-signoz",
        "cluster": "${var.ecs_cluster_id}",
        "task_definition": "${aws_ecs_task_definition.signoz.arn}",
        "desired_count": 1,
        "launch_type": "EC2",
        "network_configuration": {
          "subnets": "${var.subnet_ids}",
          "security_groups": "${var.security_group_ids}"
        },
        "service_registries": {
          "registry_arn": "${aws_service_discovery_service.signoz.arn}"
        },
        "depends_on": [
          "aws_cloudwatch_log_group.ecs",
          "aws_ecs_service.metastore",
          "aws_ecs_service.telemetrystore"
        ]
      }
    }
  }
}
